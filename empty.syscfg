PWM2.ccp1PinConfig.$name        = "ti_driverlib_gpio_GPIOPinGeneric12";

PWM3.$name                      = "PWM_2";
PWM3.clockDivider               = 8;
PWM3.peripheral.ccp1Pin.$assign = "PA25";
PWM3.PWM_CHANNEL_0.$name        = "ti_driverlib_pwm_PWMTimerCC4";
